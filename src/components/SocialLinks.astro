---
interface SocialLink {
	href: string;
	label: string;
	icon: "github" | "bluesky" | "linkedin";
}

const socialLinks: SocialLink[] = [
	{
		href: "https://github.com/jswny",
		label: "GitHub",
		icon: "github",
	},
	{
		href: "https://bsky.app/profile/j1.io",
		label: "Bluesky",
		icon: "bluesky",
	},
	{
		href: "https://www.linkedin.com/in/jswny/",
		label: "LinkedIn",
		icon: "linkedin",
	},
];
---

<div class="social-links">
	{
		socialLinks.map(({ href, label, icon }) => (
			<a href={href} target="_blank" rel="me noopener noreferrer">
				<span class="sr-only">{label}</span>
				{
					icon === "github" ? (
						<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32">
							<path
								fill="currentColor"
								d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
							/>
						</svg>
					) : icon === "bluesky" ? (
						<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32">
							<path
								fill="currentColor"
								d="M12 10.8c-1.1-2.11-4.05-6.05-6.8-8C2.57.95 1.56 1.27.9 1.57.14 1.91 0 3.08 0 3.77c0 .69.38 5.65.62 6.48.82 2.73 3.71 3.66 6.38 3.36.14-.02.28-.04.42-.06-.14.02-.28.04-.42.06-3.91.58-7.39 2.01-2.83 7.08 5.01 5.19 6.87-1.11 7.83-4.31.95 3.2 2.05 9.27 7.73 4.31 4.27-4.31 1.17-6.5-2.74-7.08-.14-.02-.28-.04-.41-.06.14.02.28.04.41.06 2.67.3 5.57-.63 6.38-3.36.25-.83.63-5.79.63-6.48 0-.69-.14-1.86-.9-2.2-.66-.3-1.67-.62-4.3 1.24-2.75 1.94-5.7 5.88-6.8 7.99z"
							/>
						</svg>
					) : (
						<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32">
							<path
								fill="currentColor"
								d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zm1.78 13.02H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"
							/>
						</svg>
					)
				}
			</a>
		))
	}
</div>

<style>
	.social-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}
	.social-links a {
		display: flex;
		align-items: center;
		justify-content: center;
		color: rgb(var(--gray));
		line-height: 1;
		text-decoration: none;
	}
	.social-links a:hover,
	.social-links a:focus {
		color: rgb(var(--gray-dark));
	}
	.social-links svg {
		display: block;
	}
</style>
